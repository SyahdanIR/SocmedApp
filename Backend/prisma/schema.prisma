// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: npx create-db

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma" // atau "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  username      String  @unique
  full_name     String
  email         String   @unique
  password      String
  photo_profile String?
  bio           String?
  createdAt     DateTime @default(now())

  createby    Like[]     @relation("createby")
  followings Following[] @relation("following")
  followers  Following[] @relation("follower")
  userid      Like[]     @relation("userid")

  threads Thread[]
  replies Reply[]

  @@map("users")
}

model Like {
  id      Int   @id @default(autoincrement())
  user_id Int
  userid  User @relation("userid", fields: [user_id], references: [id])

  thread_id  Int
  threadLike Thread  @relation(fields: [thread_id], references: [id])
  createdAt  DateTime @default(now())
  created_by Int
  createby   User    @relation("createby", fields: [created_by], references: [id])

  updated_at DateTime @default(now())
  updated_by Int

  @@map("likes")
}

model Following {
  id           Int   @id @default(autoincrement())
  following_id Int
  followingId  User @relation("following", fields: [following_id], references: [id])

  follower_id Int
  followerId  User    @relation("follower", fields: [follower_id], references: [id])
  
  created_at  DateTime @default(now())
  uodate_at   DateTime @default(now())
  usersId     Int?

  @@map("followings")
}

model Thread {
  id                Int      @id @default(autoincrement())
  content           String?
  image             String?
  number_of_replies Int
  createdAt         DateTime @default(now())
  created_by        Int
  updated_at        DateTime @default(now())
  updated_by        Int

  threads User     @relation(fields: [created_by], references: [id])
  replies Reply[]
  likes   Like[]

  @@map("threads")
}

model Reply {
  id      Int   @id @default(autoincrement())
  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  thread_id  Int
  thread     Thread  @relation(fields: [thread_id], references: [id])
  image      String
  content    String
  createdAt  DateTime @default(now())
  created_by Int
  updated_at DateTime @default(now())
  updated_by Int

  @@map("replies")
}